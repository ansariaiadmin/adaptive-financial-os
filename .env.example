# ============================================
# adaptive-financial-os — .env.example — جادوگر v3.0.0 — پشتیبانی صفر — Zero Support
# cp .env.example .env → ./install.sh
# ============================================

# --- Database ---
PGHOST=localhost
PGPORT=5432
PGUSER=afos
PGPASSWORD=afos
PGDATABASE=afos
DATABASE_URL=postgresql://afos:afos@localhost:5432/afos

# --- Outbox Relay ---
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=30000
OUTBOX_JITTER_RATIO=0.2
OUTBOX_WEBHOOK_URL=http://localhost:3000/webhook/outbox
OUTBOX_WEBHOOK_TIMEOUT_MS=5000

# --- API ---
PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_jwt_secret_32_bytes_min
OPENAI_API_KEY=

# --- SMS + Email — برای ناتیف مالی ---
# چیه؟ وقتی تراکنش مالی می‌شه ناتیف می‌ده
SMS_PROVIDER=mock
SMS_API_KEY=
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=pass

# --- Notification System — سقف 10/10 — جدید v3.0.0 ---
# چیه؟ اطلاع‌رسانی تراکنش + مانده + خطا — کانال‌ها: in_app + email + sms + telegram
NOTIF_IN_APP=true
NOTIF_EMAIL=true
NOTIF_SMS=true
NOTIF_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# --- Fallback + Throttling — تاریکی روشن شد — v3.1.0 ---
# چیه؟ اگر یه پرووایدر خراب شد چی؟ fallback — اگر SMS fail شد in_app+email می‌ره — امن
# throttling چیه؟ اگر 5 SMS در 1 دقیقه بیاد خلاصه می‌شه — هزینه کنترل — spam جلوگیری
SMS_FALLBACK_PROVIDERS=ghasedak,kavenegar,mock
SMS_THROTTLING_ENABLED=true
SMS_THROTTLING_MAX_PER_MINUTE=5
NOTIF_FALLBACK_ENABLED=true
NOTIF_THROTTLING_ENABLED=true
NOTIF_THROTTLING_MAX_PER_MINUTE=10
NOTIF_THROTTLING_DIGEST_ENABLED=true
