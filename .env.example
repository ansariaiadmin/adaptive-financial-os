# adaptive-financial-os — Environment Template
# Copy to .env: cp .env.example .env

# Database
PGHOST=localhost
PGPORT=5432
PGUSER=afos
PGPASSWORD=afos
PGDATABASE=afos
DATABASE_URL=postgresql://afos:afos@localhost:5432/afos

# Outbox Relay
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=30000
OUTBOX_JITTER_RATIO=0.2
OUTBOX_WEBHOOK_URL=http://localhost:3000/webhook/outbox
OUTBOX_WEBHOOK_TIMEOUT_MS=5000

# API
PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_jwt_secret_32_bytes_min

# Optional LLM (for future)
OPENAI_API_KEY=
